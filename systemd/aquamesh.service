[Unit]
Description=AquaMesh flood reasoning platform
After=network.target

[Service]
User=pi
WorkingDirectory=/home/pi/aquamesh-mvp
ExecStart=/usr/bin/python3 /home/pi/aquamesh-mvp/run.py
# Optional: Environment=AQUAMESH_TOKEN=change-me   (required for any POST/control call when set)
# Optional: Environment=PUSH_URL=http://yourserver/ingest   (alerts are buffered locally if offline)
# Optional: Environment=TTGO_PORT=/dev/ttyACM0
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
